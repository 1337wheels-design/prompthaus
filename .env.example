# Kopie: cp .env.example .env — Werte eintragen, .env niemals committen (steht in .gitignore)

SUPABASE_PROJECT_REF=yoeehrdsrfwolzdtgmel
SUPABASE_URL=https://yoeehrdsrfwolzdtgmel.supabase.co
# Dashboard → Project Settings → API → service_role (secret, nur lokal/CI)
SUPABASE_SERVICE_ROLE_KEY=

SHOPIFY_SHOP_DOMAIN=xwk1u9-6z.myshopify.com
# Admin → Apps → Headless/Custom → Storefront API → public access token
SHOPIFY_STOREFRONT_TOKEN=

# Längeres Secret (NICHT der 32-Zeichen Storefront-Token):
# npm run supabase:shop-sync:setup -- --generate-cron-secret
# Oder Supabase Dashboard → Edge Functions → Secrets → DECK_SYNC_CRON_SECRET
DECK_SYNC_CRON_SECRET=

# Optional: lokaler Reservierungs-Proxy
DECK_RESERVE_TTL_MS=300000
PAYDAY_RESERVE_PORT=8791

# Optional: Vercel CLI / npm run vercel:redeploy
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
