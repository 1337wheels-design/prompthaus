{% comment %}
  Üpark Payday — Featured Collection (native Shopify products)
{% endcomment %}

<section class="payday-shop" id="shop">
  <div class="page-width">
    <h2 class="payday-shop__title">{{ section.settings.heading }}</h2>
    <p class="payday-shop__sub">{{ section.settings.subheading }}</p>

    {% if section.settings.collection != blank %}
      <div class="payday-shop__grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <article class="payday-shop__card">
            <a href="{{ product.url }}" class="payday-shop__link">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="400"
                  height="400"
                  loading="lazy"
                  class="payday-shop__img"
                >
              {% else %}
                <div class="payday-shop__img payday-shop__img--placeholder">◈</div>
              {% endif %}
              <h3 class="payday-shop__name">{{ product.title }}</h3>
              <p class="payday-shop__price">{{ product.price | money }}</p>
            </a>
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="payday-btn payday-btn--primary payday-shop__add">
                In den Warenkorb
              </button>
            </form>
          </article>
        {% endfor %}
      </div>
      <div class="payday-shop__footer">
        <a href="{{ section.settings.collection.url }}" class="payday-btn payday-btn--ghost">
          Alle Produkte
        </a>
      </div>
    {% else %}
      <p class="payday-shop__empty">Collection „Packs" in Theme-Einstellungen zuweisen.</p>
    {% endif %}
  </div>
</section>

<style>
  .payday-shop {
    background: #07100a;
    padding: 64px 24px;
    font-family: 'Courier New', monospace;
    color: #c8c0a8;
  }
  .payday-shop__title {
    font-family: Impact, sans-serif;
    font-size: 28px;
    color: #f0d060;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }
  .payday-shop__sub {
    text-align: center;
    font-size: 11px;
    color: rgba(201,160,32,0.5);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 32px;
  }
  .payday-shop__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    max-width: 960px;
    margin: 0 auto;
  }
  .payday-shop__card {
    border: 1px solid rgba(201,160,32,0.18);
    background: rgba(8,16,10,0.7);
    padding: 16px;
    text-align: center;
  }
  .payday-shop__link { text-decoration: none; color: inherit; display: block; }
  .payday-shop__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 12px;
    background: #0a120c;
  }
  .payday-shop__img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: rgba(201,160,32,0.3);
  }
  .payday-shop__name {
    font-size: 12px;
    color: #f0d060;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 6px;
  }
  .payday-shop__price {
    font-size: 14px;
    color: #e8c848;
    margin: 0 0 12px;
  }
  .payday-shop__add {
    width: 100%;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .payday-shop__footer { text-align: center; margin-top: 32px; }
  .payday-shop__empty {
    text-align: center;
    color: #a8a090;
    padding: 32px;
  }
  .payday-btn {
    display: inline-block;
    padding: 10px 20px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgba(201,160,32,0.4);
    background: rgba(201,160,32,0.15);
    color: #f0d060;
  }
  .payday-btn--ghost { background: transparent; color: #c8c0a8; }
</style>

{% schema %}
{
  "name": "Payday Shop",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Tickets & Packs" },
    { "type": "text", "id": "subheading", "label": "Untertitel", "default": "Tombola-Lose proportional zur Pack-Größe" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "default": 6, "label": "Anzahl Produkte" }
  ],
  "presets": [{ "name": "Payday Shop" }]
}
{% endschema %}
